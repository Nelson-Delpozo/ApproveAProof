generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  customers   Customer[]
  proofs      Proof[]
  revisions   Revision[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  auth0Subject String   @unique
  email        String   @unique
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proofs       Proof[]

  @@index([organizationId])
}

model Proof {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @db.Uuid
  customerId        String?     @db.Uuid
  currentRevisionId String?     @db.Uuid
  recipientName     String
  recipientEmail    String?
  title             String
  status            ProofStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  revisions       Revision[]   @relation("ProofRevisions")
  currentRevision Revision?    @relation("ProofCurrentRevision", fields: [id, currentRevisionId], references: [proofId, id], onDelete: NoAction, onUpdate: NoAction)

  activities ProofActivity[]

  dispatches ProofDispatch[]

  @@unique([id, organizationId])
  @@unique([id, currentRevisionId])
  @@index([organizationId])
  @@index([customerId])
}

model Revision {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  proofId        String   @db.Uuid
  number         Int
  fileKey        String
  fileName       String
  fileType       String
  fileSize       Int
  fileHash       String
  createdAt      DateTime @default(now())

  proof           Proof           @relation("ProofRevisions", fields: [proofId, organizationId], references: [id, organizationId], onDelete: Cascade)
  currentForProof Proof?          @relation("ProofCurrentRevision")
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses       ProofResponse[]

  dispatches ProofDispatch[]

  @@unique([proofId, number])
  @@unique([proofId, id])
  @@unique([organizationId, proofId, id])
  @@index([proofId])
  @@index([organizationId])
}

model ProofResponse {
  id                        String            @id @default(uuid()) @db.Uuid
  organizationId            String            @db.Uuid
  proofId                   String            @db.Uuid
  revisionId                String            @db.Uuid
  type                      ProofResponseType
  responderName             String
  responderEmail            String?
  comments                  String?
  approvalStatementSnapshot String?
  occurredAt                DateTime          @default(now())

  revision Revision @relation(fields: [organizationId, proofId, revisionId], references: [organizationId, proofId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId])
  @@index([proofId])
  @@index([revisionId])
}

model ProofActivity {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  proofId        String            @db.Uuid
  type           ProofActivityType
  createdAt      DateTime          @default(now())

  proof Proof @relation(fields: [proofId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([proofId])
  @@index([proofId, createdAt])
}

model ProofDispatch {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  proofId        String              @db.Uuid
  revisionId     String?             @db.Uuid
  type           ProofDispatchType
  status         ProofDispatchStatus @default(PENDING)
  recipientName  String
  recipientEmail String
  attemptCount   Int                 @default(0)
  lastError      String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  proof Proof @relation(fields: [proofId, organizationId], references: [id, organizationId], onDelete: Cascade)

  revision Revision? @relation(fields: [organizationId, proofId, revisionId], references: [organizationId, proofId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@index([proofId])
  @@index([revisionId])
  @@index([status])
  @@index([scheduledAt])
}

enum ProofStatus {
  DRAFT
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  CANCELED
}

enum ProofResponseType {
  APPROVED
  CHANGES_REQUESTED
}

enum ProofActivityType {
  PROOF_CREATED
  REVISION_CREATED
  REVISION_READY
  PROOF_SENT
  PROOF_VIEWED
  CHANGES_REQUESTED
  PROOF_APPROVED
  REMINDER_SENT
  PROOF_CANCELED
  REVIEW_LINK_REGENERATED
}

enum ProofDispatchType {
  INITIAL_PROOF
  REVISION
  REMINDER
  APPROVAL_CONFIRMATION
  CHANGE_REQUEST_NOTIFICATION
}

enum ProofDispatchStatus {
  PENDING
  SENT
  FAILED
}
